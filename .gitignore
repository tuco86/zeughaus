# Cargo build output at any level.
target/

# What a runner writes into its working directory: the database plugin's
# default SQLite file and the recorder's default dataset directory.
zeughaus.sqlite*
recordings/

# Agent working notes; DESIGN.md and CHANGELOG.md are the record.
plan/

# Headless review captures: screenshots are never committed.
.impeccable/review/

# What the CI jobs keep in their workspace between runs: cargo's home and
# target directory, the weida checkout, the staged archives. A checkout
# cleans untracked files but keeps ignored ones.
.ci-cache/
