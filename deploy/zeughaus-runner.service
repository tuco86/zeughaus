[Unit]
Description=Zeughaus runner (executes graphs, owns the terminals)
Documentation=file://%h/work/git.doodleshnookie.net/tuco86/zeughaus/DESIGN.md

[Service]
Type=simple
# The binary directory is filled in by `zeughaus-runner install desktop`.
ExecStart=@BINDIR@/zeughaus-runner
# SIGUSR1 saves the workspace and execs the binary at the same path: an
# update the runner installed over it is picked up without touching a
# terminal.
ExecReload=/bin/kill -USR1 $MAINPID
# Every terminal lives in a shim this process starts, each in a transient
# scope of its own (`systemd-run --user --scope`), so systemd-oomd takes one
# terminal instead of the unit. Shims from before that, or started where
# the scope could not be had, share the unit's cgroup, and the default
# KillMode would take them down with a stop or restart; the next runner
# reattaches them instead.
KillMode=process
# A start that fails (the state directory held by another runner, a bind
# error) is retried.
Restart=on-failure
RestartSec=3s

# Shells are spawned as login shells and build their own PATH. This one only
# has to find what the runner itself runs (sh).
Environment=PATH=%h/.local/bin:@BINDIR@:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
