[Unit]
Description=Zeughaus store (SpacetimeDB)
Documentation=file://%h/work/git.doodleshnookie.net/tuco86/zeughaus/DESIGN.md

[Service]
Type=simple
# Listens on 0.0.0.0:3000 like a hand-started `spacetime start`, so other
# machines can join the session. --non-interactive fails instead of asking
# when the port is taken (a second instance started by hand).
ExecStart=%h/.local/bin/spacetime start --non-interactive
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=default.target
