[Unit]
Description=Zeughaus CI runner (executes the pipelines, owns their terminals)

[Service]
Type=simple
ExecStart=/usr/local/lib/zeughaus-ci/bin/zeughaus-runner --state-dir %h/state --keep-runs 20 --feed-addr 127.0.0.1:7444
# SIGUSR1 saves the workspace and execs the binary at the same path: an
# installed update is picked up without touching a terminal or a running job.
ExecReload=/bin/kill -USR1 $MAINPID
# Every terminal lives in a shim this process forked. The shims share the
# unit's cgroup, and the default KillMode would take every job's shell down
# with a stop or restart; the next runner reattaches them instead.
KillMode=process
# A fixed port, so the editors' `zeughaus.toml` keeps naming this runner
# across restarts; a start that fails on it is retried.
Restart=on-failure
RestartSec=5s

# Jobs build their own environment; this PATH only has to find what the
# runner itself runs (sh, git, podman, ssh, curl).
Environment=PATH=/usr/local/lib/zeughaus-ci/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
