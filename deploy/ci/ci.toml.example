# <state-dir>/ci.toml of zeughaus-ci. Without this file `zeughaus-ci serve` exits.
# Secret values live in OpenBao ([secrets]); this file only names them.

default_runner = "tuco-pc"         # runs every job that names no `machine`

# Size limit of the artifact store under <state-dir>/ci/blobs (compressed
# files of the artifact sets between jobs, kept 3 days). On sadala ci/blobs
# and ci/sets are links into the Storage Box (deploy/setup-sadala.sh).
artifact_store_gb = 100

# The largest version of one job state store (`state = [..]` in a job
# header), in MiB; a bigger save fails the job. 1 to 4096.
# state_max_mb = 1024

# The nightly round: at this local time the CI queues every repository's
# nightly (jobs with `on = ["nightly"]`) and runs them one after the other,
# in repository name order. Without it nothing runs nightly by itself.
[nightly]
at = "03:00"

# Runners that may enlist: pinned by the fingerprint printed in their
# `<state-dir>/endpoint` (weida://sha256:<fp>@host:port/). A runner that is not
# listed here is refused.
[runners.tuco-pc]
fingerprint = "<fingerprint>"
machines = ["win11"]               # Windows VMs this runner boots: `machine = "win11"`
wait_minutes = 15                  # a job waits this long for the runner, then is skipped

# `labels` are free `key` or `key=value` labels a plan's `Runs on` selects
# runners by; the CI adds `runner=<name>`, `os=` and `arch=` itself.
# `sessions = true`: the runner hosts agent sessions (plan sessions and the
# masters the CI dispatches approved plans to; it needs omp and a terminal mux).
# `ssh`: the destination a session on another runner reaches this one by,
# which makes it a machine a plan's further `Runs on` selectors can name.
[runners.tuco-pc-hannes]
fingerprint = "<fingerprint>"
sessions = true
# labels = ["gpu"]

# A job with `machine = "atik"` runs on this runner itself.
[runners.atik]
fingerprint = "<fingerprint>"
sessions = true

[runners.sadala]
fingerprint = "<fingerprint>"

# A Windows host (deploy/setup-windows.sh): it runs `.ps1` jobs on its own
# host and offers no containers and no machines. Default: os = "unix".
[runners.wohnzimmer]
fingerprint = "<fingerprint>"
os = "windows"
ssh = "zeughaus@10.8.0.12"
sessions = true

# Which runner or machine builds a platform: a job with `platform = "<p>"`
# runs there, in a container when it also names an `image`.
[platforms]
linux-amd64 = "tuco-pc"
linux-arm64 = "atik"
windows-amd64 = "win11"
darwin-arm64 = "atik"

[secrets]
addr = "http://10.8.0.1:8200"      # OpenBao on sadala over WireGuard
mount = "secret"                   # KV v2
path = "zeughaus/zeughaus"         # the CI's own document: fetch/status tokens, webhook secrets, Claude
role_id = "<printed by deploy/ci/openbao.sh>"
cache_ttl_seconds = 30             # a read document answers from memory this long
timeout_seconds = 5
# Job grants resolve in <projects>/<origin>/shell, then <projects>/shell,
# read by a wrapped job token minted through the token role `job_role`.
# projects = "zeughaus"
# job_role = "zeughaus-job"

# Onboarding requests (the MCP tool onboard_request): once the owner approves
# one in the Plans tab, the CI adds `bot` as a collaborator on Forgejo `api`
# with `admin_token`, stores a webhook secret <NAME>_WEBHOOK_SECRET in the
# [secrets] document (its policy needs `patch`), creates the hook
# `<hook_url>/<name>`, writes the repository to
# <state-dir>/ci/onboarded/<name>.toml and queues its first push pipeline.
# The onboarded repositories use `bot_token` for fetches and statuses.
# `systemctl --user reload zeughaus-ci` re-reads [repos] of this file and
# those files; any other change of this file takes a restart.
# [onboarding]
# api = "https://git.doodleshnookie.net"
# bot = "zeughaus"
# bot_token = "FORGEJO_TOKEN"
# admin_token = "FORGEJO_ADMIN_TOKEN"   # the owner's token, write:repository
# hook_url = "https://ci.doodleshnookie.net/hook"

# The Claude subscription the CI holds (Claude Code's OAuth client), signed
# in with `zeughaus-runner claude login` on a machine with a browser. It
# keeps the refresh and access tokens in [secrets]' document and hands the
# access token out over /ci (`zeughaus-runner claude token`). Adding it
# takes a restart.
# [claude]
# account = "owner@example.org"

# The language model the CI asks with that sign-in about a project that
# has not joined, for the editor's Board of it. Without it the Board still
# offers `Onboard` with the default settings and no tickets.
# [advice]
# model = "claude-haiku-5-5"

[repos.griasdi]
url = "https://github.com/Griasdi/Griasdi.git"
forge = "github"                   # github | forgejo | none
slug = "Griasdi/Griasdi"
api = "https://api.github.com"     # forgejo: https://git.doodleshnookie.net
default_branch = "main"
fetch_token = "GRIASDI_GITHUB_TOKEN" # secret name; omitted for public/local repos
fetch_user = "x-access-token"
status_token = "GRIASDI_GITHUB_TOKEN"
webhook_secret = "GRIASDI_WEBHOOK_SECRET"
# agent_sessions = true            # jobs may request agent sessions ($CI_OUTPUT/agent-session.md)
# nightly_repair = true            # a failed nightly files tickets that run through: a fix per platform, then a rerun

[repos.griasdi.grants]             # secret -> event patterns it is released to (from its project document)
GRIASDI_GITHUB_TOKEN = ["tag v*", "nightly"]

# zeughaus itself, on Forgejo. The bot user `zeughaus` is a collaborator
# with write on zeughaus (fetch, statuses). weida comes from its public GitHub
# mirror, so the jobs need no token for it.
[repos.zeughaus]
url = "https://git.doodleshnookie.net/tuco86/zeughaus.git"
forge = "forgejo"
slug = "tuco86/zeughaus"
api = "https://git.doodleshnookie.net"
default_branch = "main"
fetch_token = "FORGEJO_TOKEN"
fetch_user = "zeughaus"
status_token = "FORGEJO_TOKEN"
webhook_secret = "ZEUGHAUS_WEBHOOK_SECRET"

[repos.zeughaus.grants]
ZEUGHAUS_UPDATE_KEY = ["push main", "nightly", "tag v*"]
ZEUGHAUS_GITHUB_TOKEN = ["push main", "nightly", "tag v*"]

[repos.smoke]
url = "/var/lib/zeughaus-ci/smoke.git"
forge = "none"
slug = "local/smoke"
api = ""
default_branch = "main"
