# <state-dir>/ci.toml of zeughaus-ci. Without this file `zeughaus-ci serve` exits.
# Secret values live in OpenBao ([secrets]); this file only names them.

default_runner = "tuco-pc"         # runs every job that names no `machine`

# Runners that may enlist: pinned by the fingerprint printed in their
# `<state-dir>/endpoint` (weida://sha256:<fp>@host:port/). A runner that is not
# listed here is refused.
[runners.tuco-pc]
fingerprint = "<fingerprint>"
machines = ["win11"]               # Windows VMs this runner boots: `machine = "win11"`
wait_minutes = 15                  # a job waits this long for the runner, then is skipped

[runners.tuco-pc-hannes]
fingerprint = "<fingerprint>"

# A job with `machine = "atik"` runs on this runner itself.
[runners.atik]
fingerprint = "<fingerprint>"

[runners.sadala]
fingerprint = "<fingerprint>"

[secrets]
addr = "http://10.8.0.1:8200"      # OpenBao on sadala over WireGuard
mount = "secret"                   # KV v2
path = "zeughaus/ci"               # one document; its fields are the secret names
role_id = "<printed by deploy/ci/openbao.sh>"
cache_ttl_seconds = 30             # a read document answers from memory this long
timeout_seconds = 5

[repos.griasdi]
url = "https://github.com/Griasdi/Griasdi.git"
forge = "github"                   # github | forgejo | none
slug = "Griasdi/Griasdi"
api = "https://api.github.com"     # forgejo: https://git.doodleshnookie.net
default_branch = "main"
fetch_token = "GITHUB_TOKEN"       # secret name; omitted for public/local repos
fetch_user = "x-access-token"
status_token = "GITHUB_TOKEN"
webhook_secret = "GRIASDI_WEBHOOK_SECRET"

[repos.griasdi.grants]             # secret -> event patterns it is released to
GITHUB_TOKEN = ["tag v*", "cron *"]

# zeughaus itself, on Forgejo. The bot user `zeughaus-ci` is a collaborator
# with write on zeughaus (fetch, statuses) and read on weida, the sibling
# checkout the workspace builds against; jobs get only the read token.
[repos.zeughaus]
url = "https://git.doodleshnookie.net/tuco86/zeughaus.git"
forge = "forgejo"
slug = "tuco86/zeughaus"
api = "https://git.doodleshnookie.net"
default_branch = "main"
fetch_token = "FORGEJO_TOKEN"
fetch_user = "zeughaus-ci"
status_token = "FORGEJO_TOKEN"
webhook_secret = "ZEUGHAUS_WEBHOOK_SECRET"

[repos.zeughaus.grants]
FORGEJO_READ_TOKEN = ["push *", "tag *", "cron *"]

[repos.smoke]
url = "/var/lib/zeughaus-ci/smoke.git"
forge = "none"
slug = "local/smoke"
api = ""
default_branch = "main"
