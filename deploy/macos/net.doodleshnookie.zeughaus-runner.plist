<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>net.doodleshnookie.zeughaus-runner</string>
    <key>ProgramArguments</key>
    <array>
        <string>@BINDIR@/zeughaus-runner</string>
        <string>--feed-addr</string>
        <string>@FEED_ADDR@</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>@BINDIR@:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>@LOGS@/zeughaus-runner.log</string>
    <key>StandardErrorPath</key>
    <string>@LOGS@/zeughaus-runner.log</string>
</dict>
</plist>
