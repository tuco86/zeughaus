[Unit]
Description=Zeughaus runner of a service user (executes graphs and CI jobs, owns their terminals)

[Service]
Type=simple
# `zeughaus-runner install service` fills in the binary directory (~/bin,
# owned by this user, so the runner can update itself) and the feed address:
# a fixed one, so the editors' `zeughaus.toml` and the CI keep naming this
# runner across restarts.
ExecStart=@BINDIR@/zeughaus-runner --state-dir %h/state --keep-runs 20 --feed-addr @FEED_ADDR@
# SIGUSR1 saves the workspace and execs the binary at the same path: an
# installed update is picked up without touching a terminal or a running job.
ExecReload=/bin/kill -USR1 $MAINPID
# Every terminal lives in a shim this process starts, each in a transient
# scope of its own (`systemd-run --user --scope`), so systemd-oomd takes one
# job's terminal instead of the unit. Shims started where the scope could
# not be had share the unit's cgroup, and the default KillMode would take
# every job's shell down with a stop or restart; the next runner reattaches
# them instead.
KillMode=process
# A start that fails on the fixed port is retried.
Restart=on-failure
RestartSec=5s

# Jobs build their own environment; this PATH only has to find what the
# runner itself runs (sh, git, podman, ssh, tar).
Environment=PATH=@BINDIR@:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
